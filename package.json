{
  "name": "treewatch",
  "version": "0.1.0",
  "description": "Live file tree visualizer for watching agent/editor changes since the last git commit",
  "type": "module",
  "bin": {
    "treewatch": "./src/index.js"
  },
  "scripts": {
    "build": "esbuild src/App.jsx --bundle --outfile=dist/app.js --format=esm --platform=node --jsx=automatic --external:react --external:ink --external:chokidar",
    "start": "npm run build --silent && node src/index.js",
    "test": "node test/stress-test.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.1",
    "ink": "^5.1.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
